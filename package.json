{
  "name": "muro-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "desktop": "cargo build -p muro-desktop-runtime --bins && cd apps/desktop && tauri dev",
    "desktop:build": "cargo build -p muro-desktop-runtime --bins --release && cd apps/desktop && tauri build --no-bundle",
    "test": "node --experimental-strip-types --test apps/desktop/tests/*.test.ts"
  },
  "imago": {
    "src": ["apps/desktop/src"],
    "tests": ["apps/desktop/tests"],
    "cargo": "apps/desktop/src-tauri/Cargo.toml",
    "app": "muro",
    "icons": {
      "apps/desktop/src-tauri/icons/icon.ico": "icon.ico",
      "apps/desktop/src-tauri/icons/icon.png": "icon.png",
      "apps/desktop/src-tauri/icons/32x32.png": "32x32.png",
      "apps/desktop/src-tauri/icons/128x128.png": "128x128.png",
      "apps/desktop/src-tauri/icons/128x128@2x.png": "256x256.png"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@acaprino/imago": "https://github.com/acaprino/imago/releases/download/v1.1.0/acaprino-imago-1.1.0.tgz",
    "@acaprino/sigrid": "https://github.com/acaprino/sigrid/releases/download/v6.8.0/acaprino-sigrid-6.8.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1"
  }
}
