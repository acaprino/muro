{
  "plugin": {
    "slug": "pressroom",
    "name": "Pressroom",
    "command": "pressroom",
    "version": "0.1.0",
    "description": "Use when planning a story or a series, writing a newsletter edition, deciding and building the scroll movement of a story with GSAP or CSS only, reading, editing or converting a manuscript file, or checking the facts of a draft.",
    "replaces": [
      "story-planner",
      "series-bible",
      "newsletter-kit",
      "scroll-pacing",
      "scroll-gsap",
      "scroll-css",
      "manuscript-tools",
      "fact-checker"
    ]
  },
  "stack": {
    "detectors": [
      {
        "file": "package.json",
        "json_keys": [
          "dependencies",
          "devDependencies",
          "peerDependencies",
          "optionalDependencies"
        ],
        "contains": "gsap",
        "emits": "stack:gsap",
        "unless": [
          "stack:css-only"
        ]
      }
    ],
    "conflicts": [
      [
        "stack:gsap",
        "stack:css-only"
      ]
    ]
  },
  "sources": [
    {
      "id": "editorial-desk",
      "repo_url": "https://example.invalid/pressroom-fixture/editorial-desk",
      "commit": "4b1d6e0c9a7f3528e1d4c6b09f2a7e5d3c8b1a60",
      "pin": "release",
      "release": "v2.1.0",
      "license": "MIT",
      "copyright": "Copyright (c) 2026 Editorial Desk fixture",
      "selected_paths": [
        "skills/**",
        "checklists/**"
      ],
      "excluded_paths": [],
      "runtime_deps": [],
      "intake": {
        "goal": "Extract story planning, newsletter, manuscript file and fact-check procedures."
      }
    },
    {
      "id": "scroll-stories",
      "repo_url": "https://example.invalid/pressroom-fixture/scroll-stories",
      "commit": "e7a2c94f1b0d8365a4f7e2c1d9b6038a5f4e7d12",
      "pin": "head",
      "license": "MIT",
      "copyright": "Copyright (c) 2026 Scroll Stories fixture",
      "selected_paths": [
        "skills/scroll-stories/SKILL.md"
      ],
      "excluded_paths": [],
      "runtime_deps": [
        {
          "name": "gsap",
          "version": "3",
          "license": "separate (target project dependency)",
          "bundled": false
        }
      ],
      "intake": {
        "goal": "Extract scroll pacing limits and the two build variants, respecting reduced motion."
      }
    }
  ]
}
